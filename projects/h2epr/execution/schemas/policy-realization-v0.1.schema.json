{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/execution/schemas/policy-realization-v0.1.schema.json",
  "title": "H2EPR Policy Realization v0.1",
  "description": "Project-local Rule behavior mapped from one accepted semantic configuration. Schema validity does not confer execution eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_identity",
    "realization_id",
    "version",
    "status",
    "event_id",
    "purpose",
    "semantic_parent",
    "participant_policy_realizations",
    "scenario_policy_realizations",
    "lifecycle_realizations",
    "coverage_expectations",
    "failure_policy",
    "claim_boundary"
  ],
  "properties": {
    "format_identity": {
      "const": "h2epr.policy-realization.v0_1"
    },
    "realization_id": {
      "$ref": "#/$defs/stableId"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "status": {
      "enum": [
        "candidate",
        "accepted_policy_realization"
      ]
    },
    "event_id": {
      "$ref": "#/$defs/stableId"
    },
    "purpose": {
      "const": "mechanism_coverage"
    },
    "semantic_parent": {
      "$ref": "#/$defs/semanticParent"
    },
    "participant_policy_realizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/participantPolicyRealization"
      }
    },
    "scenario_policy_realizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenarioPolicyRealization"
      }
    },
    "lifecycle_realizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleRealization"
      }
    },
    "coverage_expectations": {
      "$ref": "#/$defs/coverageExpectations"
    },
    "failure_policy": {
      "$ref": "#/$defs/failurePolicy"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "stableIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "semanticParent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "configuration_version",
        "configuration_status",
        "configuration_path",
        "configuration_source_sha256",
        "configuration_canonical_sha256",
        "configuration_release_manifest_path",
        "configuration_release_manifest_sha256",
        "configuration_admission_receipt_path",
        "configuration_admission_receipt_sha256",
        "roster_release_manifest_path",
        "roster_release_manifest_sha256",
        "consolidated_mapping_manifest_path",
        "consolidated_mapping_manifest_sha256",
        "mapping_profile_id",
        "mapping_profile_path",
        "mapping_profile_sha256",
        "scenario_release_manifest_path",
        "scenario_release_manifest_sha256"
      ],
      "properties": {
        "configuration_id": {
          "$ref": "#/$defs/stableId"
        },
        "configuration_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "configuration_status": {
          "const": "accepted_non_executable_configuration"
        },
        "configuration_path": {
          "$ref": "#/$defs/relativePath"
        },
        "configuration_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_release_manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "configuration_release_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_admission_receipt_path": {
          "$ref": "#/$defs/relativePath"
        },
        "configuration_admission_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "roster_release_manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "roster_release_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "consolidated_mapping_manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "consolidated_mapping_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mapping_profile_id": {
          "$ref": "#/$defs/stableId"
        },
        "mapping_profile_path": {
          "$ref": "#/$defs/relativePath"
        },
        "mapping_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scenario_release_manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "scenario_release_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decisionRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment_id",
        "consumed_observation_ids",
        "persistent_state_ids",
        "emittable_intent_ids",
        "no_intent_reason_codes",
        "revisit_trigger_ids",
        "lifecycle_ids"
      ],
      "properties": {
        "commitment_id": {
          "$ref": "#/$defs/stableId"
        },
        "consumed_observation_ids": {
          "$ref": "#/$defs/stableIdArray"
        },
        "persistent_state_ids": {
          "$ref": "#/$defs/stableIdArray"
        },
        "emittable_intent_ids": {
          "$ref": "#/$defs/stableIdArray"
        },
        "no_intent_reason_codes": {
          "$ref": "#/$defs/stableIdArray"
        },
        "revisit_trigger_ids": {
          "$ref": "#/$defs/stableIdArray"
        },
        "lifecycle_ids": {
          "$ref": "#/$defs/stableIdArray"
        }
      },
      "anyOf": [
        {
          "properties": {
            "emittable_intent_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "no_intent_reason_codes": {
              "minItems": 1
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "no_intent_reason_codes": {
                "minItems": 1
              }
            },
            "required": [
              "no_intent_reason_codes"
            ]
          },
          "then": {
            "properties": {
              "revisit_trigger_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "participantPolicyRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realization_key",
        "actor_id",
        "capability_id",
        "participant_product_id",
        "implementation_id",
        "implementation_version",
        "configuration_parameter_bindings",
        "private_state_realizations",
        "decision_realizations"
      ],
      "properties": {
        "realization_key": {
          "$ref": "#/$defs/stableId"
        },
        "actor_id": {
          "$ref": "#/$defs/stableId"
        },
        "capability_id": {
          "$ref": "#/$defs/stableId"
        },
        "participant_product_id": {
          "$ref": "#/$defs/stableId"
        },
        "implementation_id": {
          "$ref": "#/$defs/stableId"
        },
        "implementation_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "configuration_parameter_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/configurationParameterBinding"
          }
        },
        "private_state_realizations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/privateStateRealization"
          }
        },
        "decision_realizations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decisionRealization"
          }
        }
      }
    },
    "privateStateRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "replay_path",
        "initialization",
        "update_trigger_ids"
      ],
      "properties": {
        "state_id": {
          "$ref": "#/$defs/stableId"
        },
        "replay_path": {
          "enum": [
            "reducer_owned_actor_private_state",
            "sealed_trace_derived_view"
          ]
        },
        "initialization": {
          "enum": [
            "configuration_parameter",
            "authoritative_projection",
            "empty",
            "trace_derived"
          ]
        },
        "update_trigger_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stableIdArray"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "configurationPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"
    },
    "configurationParameterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "source_pointer"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_pointer": {
          "$ref": "#/$defs/configurationPointer"
        }
      }
    },
    "scenarioPolicyRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "semantic_version",
        "selection",
        "implementation_id",
        "implementation_version",
        "owner_layer",
        "configuration_source_pointers",
        "governed_semantic_ids",
        "rejection_reason_codes"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/stableId"
        },
        "semantic_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "selection": {
          "$ref": "#/$defs/stableId"
        },
        "implementation_id": {
          "$ref": "#/$defs/stableId"
        },
        "implementation_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "owner_layer": {
          "enum": [
            "scheduler",
            "information",
            "environment",
            "reducer"
          ]
        },
        "configuration_source_pointers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/configurationPointer"
          }
        },
        "governed_semantic_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stableIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "rejection_reason_codes": {
          "allOf": [
            {
              "$ref": "#/$defs/stableIdArray"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "lifecycleRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_id",
        "implementation_id",
        "implementation_version",
        "owner_layer",
        "participant_capability_ids",
        "state_ids",
        "terminal_state_ids",
        "invalid_transition_behavior"
      ],
      "properties": {
        "lifecycle_id": {
          "$ref": "#/$defs/stableId"
        },
        "implementation_id": {
          "$ref": "#/$defs/stableId"
        },
        "implementation_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "owner_layer": {
          "enum": [
            "environment",
            "reducer"
          ]
        },
        "participant_capability_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stableIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "state_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stableIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "terminal_state_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stableIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "invalid_transition_behavior": {
          "const": "typed_failure_without_state_change"
        }
      }
    },
    "coverageExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_instances",
        "actor_capability_bindings",
        "population_units",
        "exogenous_inputs",
        "structural_selections",
        "decision_commitments",
        "observation_placements",
        "private_state_placements",
        "configuration_parameter_bindings",
        "intent_placements",
        "lifecycle_families",
        "selected_policies",
        "actor_capabilities_exact",
        "configuration_semantics_exact",
        "observations_and_private_state_exact",
        "commitments_and_intents_exact",
        "lifecycle_families_exact",
        "selected_policies_exact",
        "unsupported_semantics_rejected"
      ],
      "properties": {
        "actor_instances": {
          "type": "integer",
          "minimum": 1
        },
        "actor_capability_bindings": {
          "type": "integer",
          "minimum": 1
        },
        "population_units": {
          "type": "integer",
          "minimum": 0
        },
        "exogenous_inputs": {
          "type": "integer",
          "minimum": 0
        },
        "structural_selections": {
          "type": "integer",
          "minimum": 0
        },
        "decision_commitments": {
          "type": "integer",
          "minimum": 1,
          "description": "Decision Commitment placements across the configured actor-capability bindings."
        },
        "observation_placements": {
          "type": "integer",
          "minimum": 0,
          "description": "Observation placements across the configured actor-capability bindings."
        },
        "private_state_placements": {
          "type": "integer",
          "minimum": 0,
          "description": "Behaviorally material private-state placements with an authoritative replay path."
        },
        "configuration_parameter_bindings": {
          "type": "integer",
          "minimum": 0,
          "description": "Explicit actor-policy parameter bindings into the hash-pinned configuration."
        },
        "intent_placements": {
          "type": "integer",
          "minimum": 0,
          "description": "Intent placements across the configured actor-capability bindings."
        },
        "lifecycle_families": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct lifecycle families required by the configured execution."
        },
        "selected_policies": {
          "type": "integer",
          "minimum": 1
        },
        "actor_capabilities_exact": {
          "const": true
        },
        "configuration_semantics_exact": {
          "const": true
        },
        "observations_and_private_state_exact": {
          "const": true
        },
        "commitments_and_intents_exact": {
          "const": true
        },
        "lifecycle_families_exact": {
          "const": true
        },
        "selected_policies_exact": {
          "const": true
        },
        "unsupported_semantics_rejected": {
          "const": true
        }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_implementation",
        "unknown_actor_or_capability",
        "unknown_observation_or_intent",
        "unresolved_configuration_parameter",
        "invalid_lifecycle_definition",
        "invalid_runtime_transition",
        "authority_or_resource_mismatch",
        "hidden_default",
        "participant_authored_result"
      ],
      "properties": {
        "missing_implementation": {
          "const": "reject_before_run"
        },
        "unknown_actor_or_capability": {
          "const": "reject_before_run"
        },
        "unknown_observation_or_intent": {
          "const": "reject_before_run"
        },
        "unresolved_configuration_parameter": {
          "const": "reject_before_run"
        },
        "invalid_lifecycle_definition": {
          "const": "reject_before_run"
        },
        "invalid_runtime_transition": {
          "const": "typed_failure_without_state_change"
        },
        "authority_or_resource_mismatch": {
          "const": "fail_closed_without_state_change"
        },
        "hidden_default": {
          "const": "forbidden"
        },
        "participant_authored_result": {
          "const": "forbidden"
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_exposure",
        "historical_calibration",
        "historical_validation",
        "known_outcome_fitting",
        "held_out_evaluation",
        "scientific_validity_claim",
        "output_interpretation"
      ],
      "properties": {
        "construction_exposure": {
          "enum": [
            "full_event_evidence",
            "prefix_only",
            "synthetic_only"
          ]
        },
        "historical_calibration": {
          "const": false
        },
        "historical_validation": {
          "const": false
        },
        "known_outcome_fitting": {
          "const": false
        },
        "held_out_evaluation": {
          "const": false
        },
        "scientific_validity_claim": {
          "const": false
        },
        "output_interpretation": {
          "const": "simulation_generated_mechanism_coverage"
        }
      }
    }
  }
}
