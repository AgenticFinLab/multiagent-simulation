{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.participant-semantic-index.v3",
  "title": "H2EPR participant semantic index",
  "description": "Pins each active actor to one human Agent Definition or Population Model, its content hash, source participant IDs, and Draft anchors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "index_id",
    "index_version",
    "event_id",
    "actor_map_id",
    "parents",
    "index_sha256"
  ],
  "properties": {
    "schema_version": {"const": "h2epr.participant-semantic-index.v3"},
    "index_id": {"type": "string", "minLength": 1},
    "index_version": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^H2EPR-[0-9]{4}$"},
    "actor_map_id": {"type": "string", "minLength": 1},
    "parents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/parent"}
    },
    "index_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_parent_id",
        "actor_id",
        "representation_kind",
        "relative_path",
        "sha256",
        "source_participant_ids",
        "source_anchor_refs"
      ],
      "properties": {
        "semantic_parent_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "representation_kind": {"enum": ["agent", "population"]},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"},
        "sha256": {"$ref": "#/$defs/sha"},
        "source_participant_ids": {"$ref": "#/$defs/ids"},
        "source_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^draft_epg:S[0-9]+/E[0-9]+/[A-Z]_[0-9]+$"}
        }
      }
    }
  }
}
