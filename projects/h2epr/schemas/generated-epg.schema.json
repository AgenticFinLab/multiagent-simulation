{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.generated-epg.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "backend",
    "package_sha256",
    "binding_sha256",
    "source_trace_sha256",
    "nodes",
    "edges",
    "trace_coverage",
    "claim_boundary",
    "seal"
  ],
  "properties": {
    "schema_version": {"const": "h2epr.generated-epg.v3"},
    "event_id": {"type": "string", "pattern": "^H2EPR-[0-9]{4}$"},
    "run_id": {"type": "string", "minLength": 1},
    "backend": {"enum": ["rule", "llm", "rulellm"]},
    "package_sha256": {"$ref": "#/$defs/sha"},
    "binding_sha256": {"$ref": "#/$defs/sha"},
    "source_trace_sha256": {"$ref": "#/$defs/sha"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "trace_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "referenced_record_count", "unreferenced_trace_ids", "duplicate_trace_ids"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "referenced_record_count": {"type": "integer", "minimum": 1},
        "unreferenced_trace_ids": {"type": "array", "maxItems": 0},
        "duplicate_trace_ids": {"type": "array", "maxItems": 0}
      }
    },
    "claim_boundary": {"type": "object", "required": ["supports", "does_not_support"]},
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seal_type", "artifact_sha256"],
      "properties": {
        "seal_type": {"const": "h2epr.generated-epg.seal.v3"},
        "artifact_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "properties", "source_trace_ids"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "node_type": {"type": "string", "minLength": 1},
        "properties": {"type": "object"},
        "source_trace_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "edge_type", "source_id", "target_id", "source_trace_ids"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "edge_type": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "source_trace_ids": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
