{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.scenario-configuration.v3",
  "title": "H2EPR scenario configuration",
  "description": "Selects typed shared-world or backend decision values and records exact value provenance without redefining semantic parents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_id", "configuration_version", "event_id", "configuration_kind", "semantic_parent_ids", "settings", "value_provenance", "configuration_sha256"],
  "properties": {
    "schema_version": {"const": "h2epr.scenario-configuration.v3"},
    "configuration_id": {"type": "string", "minLength": 1},
    "configuration_version": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^H2EPR-[0-9]{4}$"},
    "configuration_kind": {"enum": ["shared_comparison", "backend_rule", "backend_llm", "backend_rulellm"]},
    "semantic_parent_ids": {"$ref": "#/$defs/ids"},
    "settings": {"type": "object", "minProperties": 1},
    "value_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenance"}
    },
    "configuration_sha256": {"$ref": "#/$defs/sha"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "configuration_kind": {"const": "shared_comparison"}
        }
      },
      "then": {
        "properties": {
          "settings": {"$ref": "#/$defs/sharedSettings"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "configuration_kind": {"const": "backend_rule"}
        }
      },
      "then": {
        "properties": {
          "settings": {"$ref": "#/$defs/ruleSettings"}
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "classification", "basis"],
      "properties": {
        "json_pointer": {"type": "string", "pattern": "^/"},
        "classification": {"enum": ["dataset_derived", "structural", "synthetic", "sensitivity", "model", "run_local"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_tick", "coordinate_id", "stage_id", "episode_id", "label", "source_time"],
      "properties": {
        "logical_tick": {"type": "integer", "minimum": 1},
        "coordinate_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "episode_id": {"type": "string", "pattern": "^E[0-9]+$"},
        "label": {"type": "string", "minLength": 1},
        "source_time": {"type": "string", "minLength": 1}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "source_id", "target_id", "latency_ticks"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "latency_ticks": {"type": "integer", "minimum": 1}
      }
    },
    "sharedSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "exposure_mode", "active_actor_ids", "timeline", "initial_state", "communication_routes", "observation_contract", "termination", "assumptions"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "exposure_mode": {"enum": ["prefix_clean", "full_draft_exposed"]},
        "active_actor_ids": {"$ref": "#/$defs/ids"},
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/coordinate"}
        },
        "initial_state": {
          "type": "object",
          "required": ["state_version", "entities"],
          "properties": {
            "state_version": {"const": 0},
            "entities": {"type": "object", "minProperties": 1}
          },
          "additionalProperties": false
        },
        "communication_routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/route"}
        },
        "observation_contract": {"type": "object", "minProperties": 1},
        "termination": {
          "type": "object",
          "required": ["require_all_ticks", "require_no_unresolved_messages"],
          "properties": {
            "require_all_ticks": {"const": true},
            "require_no_unresolved_messages": {"const": true}
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "guard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_id", "field_name", "operator", "value"],
          "properties": {
            "kind": {"const": "state"},
            "entity_id": {"type": "string", "minLength": 1},
            "field_name": {"type": "string", "minLength": 1},
            "operator": {"enum": ["equals", "not_equals", "contains", "gte", "lte"]},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message_kind"],
          "properties": {
            "kind": {"enum": ["message_received", "message_known"]},
            "message_kind": {"type": "string", "minLength": 1},
            "sender_id": {"type": "string", "minLength": 1},
            "max_age_ticks": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipient_id", "message_type", "payload"],
      "properties": {
        "recipient_id": {"type": "string", "minLength": 1},
        "message_type": {"type": "string", "minLength": 1},
        "payload": {"type": "object"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "actor_id", "priority", "guards", "action", "messages", "reason"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "coordinate_id": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0},
        "guards": {
          "type": "array",
          "items": {"$ref": "#/$defs/guard"}
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_type", "parameters"],
          "properties": {
            "action_type": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        },
        "messages": {
          "type": "array",
          "items": {"$ref": "#/$defs/message"}
        },
        "reason": {"type": "string", "minLength": 1},
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_coordinate_id", "end_coordinate_id", "retry_policy"],
          "properties": {
            "start_coordinate_id": {"type": "string", "minLength": 1},
            "end_coordinate_id": {"type": "string", "minLength": 1},
            "retry_policy": {"const": "on_new_information"}
          }
        }
      },
      "oneOf": [
        {
          "required": ["coordinate_id"],
          "not": {"required": ["activation"]}
        },
        {
          "required": ["activation"],
          "not": {"required": ["coordinate_id"]}
        }
      ]
    },
    "ruleSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "deterministic", "model_access", "network_access", "default_action", "decision_rules"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "deterministic": {"const": true},
        "model_access": {"const": "denied"},
        "network_access": {"const": "denied"},
        "default_action": {"const": "no_op"},
        "decision_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rule"}
        }
      }
    }
  }
}
