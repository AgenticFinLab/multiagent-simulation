{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.participant-interface.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interface_id", "interface_version", "event_id", "actor_map_id", "actors", "interface_sha256"],
  "properties": {
    "schema_version": {"const": "h2epr.participant-interface.v2"},
    "interface_id": {"type": "string", "minLength": 1},
    "interface_version": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^H2EPR-[0-9]{4}$"},
    "actor_map_id": {"type": "string", "minLength": 1},
    "actors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actor"}},
    "interface_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "representation_kind", "semantic_parent_id", "observation_ids", "intent_ids", "lifecycle_ids", "persistent_state_fields"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "representation_kind": {"enum": ["agent", "population"]},
        "semantic_parent_id": {"type": "string", "minLength": 1},
        "observation_ids": {"$ref": "#/$defs/ids"}, "intent_ids": {"$ref": "#/$defs/ids"},
        "lifecycle_ids": {"$ref": "#/$defs/ids"}, "persistent_state_fields": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
