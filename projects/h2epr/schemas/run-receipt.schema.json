{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.run-receipt.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "package_sha256",
    "binding_sha256",
    "run_manifest_sha256",
    "trace_sha256",
    "final_state_sha256",
    "run_seal_sha256",
    "replay_passed",
    "generated_epg_sha256",
    "trace_coverage_passed",
    "counts",
    "unresolved_transport_count",
    "claim_boundary",
    "custody",
    "output_files",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "h2epr.run-receipt.v3"},
    "run_id": {"type": "string", "minLength": 1},
    "package_sha256": {"$ref": "#/$defs/sha"},
    "binding_sha256": {"$ref": "#/$defs/sha"},
    "run_manifest_sha256": {"$ref": "#/$defs/sha"},
    "trace_sha256": {"$ref": "#/$defs/sha"},
    "final_state_sha256": {"$ref": "#/$defs/sha"},
    "run_seal_sha256": {"$ref": "#/$defs/sha"},
    "replay_passed": {"const": true},
    "generated_epg_sha256": {"$ref": "#/$defs/sha"},
    "trace_coverage_passed": {"const": true},
    "counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "unresolved_transport_count": {"const": 0},
    "claim_boundary": {"$ref": "#/$defs/claim"},
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_locator", "inventory_sha256"],
      "properties": {
        "relative_locator": {"type": "string", "pattern": "^\\.local-runtime/"},
        "inventory_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "output_files": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/file"}},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "does_not_support": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
