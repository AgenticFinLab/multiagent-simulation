{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.conformance-receipt.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "conformance_kind",
    "left_identity",
    "right_identity",
    "checks",
    "passed",
    "limitations",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "h2epr.conformance-receipt.v3"},
    "receipt_id": {"type": "string", "minLength": 1},
    "conformance_kind": {"enum": ["generated_identity", "cross_event_contract"]},
    "left_identity": {"type": "object", "minProperties": 1},
    "right_identity": {"type": "object", "minProperties": 1},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "passed": {"const": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "passed", "evidence"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "passed": {"const": true},
        "evidence": {"type": "object"}
      }
    }
  }
}
