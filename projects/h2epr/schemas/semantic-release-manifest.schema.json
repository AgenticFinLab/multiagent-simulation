{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.semantic-release-manifest.v2",
  "title": "H2EPR semantic release manifest",
  "description": "Seals the exact reader and machine artifacts of one roster, interface, Scenario, configuration, or backend realization release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "release_version", "event_id", "release_kind", "artifacts", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "h2epr.semantic-release-manifest.v2"},
    "release_id": {"type": "string", "minLength": 1},
    "release_version": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^H2EPR-[0-9]{4}$"},
    "release_kind": {"enum": ["roster", "participant_interfaces", "scenario_definition", "scenario_configuration", "backend_realization"]},
    "semantic_parent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "manifest_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "role", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
