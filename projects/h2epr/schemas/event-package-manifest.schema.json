{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.event-package.manifest.v4",
  "title": "H2EPR event package manifest",
  "description": "Seals the backend-neutral package core separately from backend availability, attachments, source exposure, and claim exclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "event_id",
    "canonicalization_version",
    "source_profile",
    "source_exposure",
    "protocol_eligibility",
    "semantic_assembly_sha256",
    "semantic_assets",
    "components",
    "backend_catalog_sha256",
    "backend_bindings",
    "claim_boundary",
    "package_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "h2epr.event-package.manifest.v4"},
    "package_id": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^H2EPR-[0-9]{4}$"},
    "canonicalization_version": {"const": "h2epr.benchmark.cjson.v1"},
    "source_profile": {"$ref": "#/$defs/file"},
    "source_exposure": {"enum": ["prefix_clean", "full_draft_exposed"]},
    "protocol_eligibility": {"type": "string", "minLength": 1},
    "semantic_assembly_sha256": {"$ref": "#/$defs/sha"},
    "semantic_assets": {"$ref": "#/$defs/file"},
    "components": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/file"}},
    "backend_catalog_sha256": {"$ref": "#/$defs/sha"},
    "backend_bindings": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/backend"}},
    "claim_boundary": {"$ref": "#/$defs/claim"},
    "package_sha256": {"$ref": "#/$defs/sha"},
    "manifest_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "backend": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "status", "binding_id", "binding_sha256", "relative_path", "sha256", "size_bytes"],
          "properties": {
            "backend": {"enum": ["rule", "llm", "rulellm"]},
            "status": {"const": "implemented"},
            "binding_id": {"type": "string", "minLength": 1},
            "binding_sha256": {"$ref": "#/$defs/sha"},
            "relative_path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha"},
            "size_bytes": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "status"],
          "properties": {
            "backend": {"enum": ["rule", "llm", "rulellm"]},
            "status": {"const": "planned"}
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "does_not_support"],
      "properties": {
        "supports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "does_not_support": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
