{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h2epr.backend-binding.v4",
  "title": "H2EPR backend binding",
  "description": "Binds one implemented decision backend and its configuration, realization, source inventory, and failure contract to an event package without changing the semantic core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "binding_version",
    "event_id",
    "package_sha256",
    "backend",
    "decision_interface",
    "realization_id",
    "realization_sha256",
    "realization_relative_path",
    "configuration_id",
    "configuration_sha256",
    "configuration_relative_path",
    "configuration_provenance_coverage_id",
    "configuration_provenance_coverage_sha256",
    "configuration_provenance_relative_path",
    "implementation_id",
    "implementation_version",
    "actor_ids",
    "action_spaces",
    "run_defaults",
    "deterministic",
    "model_access",
    "network_access",
    "failure_routing",
    "implementation_sources",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {"const": "h2epr.backend-binding.v4"},
    "binding_id": {"type": "string", "minLength": 1},
    "binding_version": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "pattern": "^H2EPR-[0-9]{4}$"},
    "package_sha256": {"$ref": "#/$defs/sha"},
    "backend": {"enum": ["rule", "llm", "rulellm"]},
    "decision_interface": {"const": "h2epr.participant-decision.v2"},
    "realization_id": {"type": "string", "minLength": 1},
    "realization_sha256": {"$ref": "#/$defs/sha"},
    "realization_relative_path": {"$ref": "#/$defs/path"},
    "configuration_id": {"type": "string", "minLength": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha"},
    "configuration_relative_path": {"$ref": "#/$defs/path"},
    "configuration_provenance_coverage_id": {"type": "string", "minLength": 1},
    "configuration_provenance_coverage_sha256": {"$ref": "#/$defs/sha"},
    "configuration_provenance_relative_path": {"$ref": "#/$defs/path"},
    "implementation_id": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "actor_ids": {"$ref": "#/$defs/ids"},
    "action_spaces": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/ids"}},
    "run_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "tick_count"],
      "properties": {"seed": {"type": "integer"}, "tick_count": {"type": "integer", "minimum": 1}}
    },
    "deterministic": {"type": "boolean"},
    "model_access": {"enum": ["denied", "required"]},
    "network_access": {"enum": ["denied", "required"]},
    "failure_routing": {"type": "object", "minProperties": 1},
    "implementation_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "binding_sha256": {"$ref": "#/$defs/sha"}
  },
  "allOf": [
    {
      "if": {"properties": {"backend": {"const": "rule"}}},
      "then": {
        "properties": {
          "deterministic": {"const": true},
          "model_access": {"const": "denied"},
          "network_access": {"const": "denied"}
        }
      }
    },
    {
      "if": {"properties": {"backend": {"enum": ["llm", "rulellm"]}}},
      "then": {"properties": {"model_access": {"const": "required"}}}
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {"relative_path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}}
    }
  }
}
