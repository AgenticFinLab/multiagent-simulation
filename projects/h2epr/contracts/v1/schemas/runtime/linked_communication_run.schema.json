{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticfinlab.local/h2epr/contracts/v1/schemas/runtime/linked_communication_run.schema.json",
  "title": "Linked Communication Run V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_version",
    "trace",
    "decision_communication_histories",
    "run_seal_closure"
  ],
  "properties": {
    "fixture_version": {
      "const": "communication.linked_run.v1"
    },
    "trace": {
      "$ref": "https://agenticfinlab.local/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/SimulationTrace"
    },
    "decision_communication_histories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/DecisionCommunicationHistory"
      }
    },
    "run_seal_closure": {
      "$ref": "https://agenticfinlab.local/h2epr/contracts/v1/schemas/runtime/communication_history.schema.json#/$defs/CommunicationRunSealClosure"
    }
  },
  "$defs": {
    "DecisionCommunicationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_record",
        "attempts"
      ],
      "properties": {
        "decision_record": {
          "$ref": "https://agenticfinlab.local/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/DecisionRecord"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "https://agenticfinlab.local/h2epr/contracts/v1/schemas/runtime/communication_history.schema.json#/$defs/CommunicationAttemptHistory"
          }
        }
      }
    }
  }
}
