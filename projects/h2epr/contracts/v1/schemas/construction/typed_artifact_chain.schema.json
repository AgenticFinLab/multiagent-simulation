{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/construction/typed_artifact_chain.schema.json",
  "title": "Construction-through-Evaluation Typed Artifact Chain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain_schema_version",
    "chain_anchor",
    "construction_bundle",
    "runtime_bundle",
    "run_manifest",
    "simulation_trace",
    "generated_epg",
    "evaluation_report"
  ],
  "properties": {
    "chain_schema_version": {
      "const": "h2epr.typed.artifact.chain.v1"
    },
    "chain_anchor": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/ArtifactLineageRef"
        },
        {
          "properties": {
            "artifact_kind": {
              "enum": [
                "full_draft_target_demo_construction_bundle",
                "prefix_contaminated_demo_construction_bundle",
                "prefix_clean_strict_construction_bundle"
              ]
            }
          }
        }
      ]
    },
    "construction_bundle": {
      "oneOf": [
        {
          "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/FullDraftTargetDemoConstructionBundle"
        },
        {
          "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/PrefixContaminatedDemoConstructionBundle"
        },
        {
          "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/PrefixCleanStrictConstructionBundle"
        }
      ]
    },
    "runtime_bundle": {
      "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/RuntimeScenarioBundle"
    },
    "run_manifest": {
      "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/RunManifest"
    },
    "simulation_trace": {
      "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/SimulationTrace"
    },
    "generated_epg": {
      "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/GeneratedEPG"
    },
    "evaluation_report": {
      "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/evaluation/evaluation_report.schema.json#/$defs/EvaluationReport"
    }
  }
}
