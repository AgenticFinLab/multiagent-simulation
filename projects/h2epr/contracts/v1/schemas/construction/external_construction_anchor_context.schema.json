{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/construction/external_construction_anchor_context.schema.json",
  "title": "Synthetic External Construction Anchor Context V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_schema_version",
    "context_id",
    "anchor_class",
    "source_allowlist_id",
    "source_allowlist_sha256",
    "selected_entry_id",
    "event_id",
    "expected_construction_lineage",
    "binding_policy",
    "producer_identity",
    "context_hash_preimage",
    "context_sha256"
  ],
  "properties": {
    "context_schema_version": {
      "const": "h2epr.external.construction.anchor.context.v1"
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "anchor_class": {
      "const": "synthetic_test_only"
    },
    "source_allowlist_id": {
      "type": "string",
      "minLength": 1
    },
    "source_allowlist_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_entry_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_construction_lineage": {
      "$ref": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/ArtifactLineageRef"
    },
    "binding_policy": {
      "const": "external_exact_lineage_tuple_and_content_sha256.v1"
    },
    "producer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "producer_id",
        "producer_version"
      ],
      "properties": {
        "role": {
          "const": "contract_fixture_producer"
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "producer_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context_hash_preimage": {
      "const": "omit_context_sha256"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
