{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticfinlab.local/h2epr/contracts/v1/schemas/scenarios/panic_1907/h2epr_0288_strict_source_policy.schema.json",
  "title": "H2EPR-0288 Strict Event-Spec and Source Allowlist",
  "allOf": [
    {
      "$ref": "https://agenticfinlab.local/h2epr/contracts/v1/schemas/core/h2epr_core.schema.json#/$defs/StrictSourceFieldPolicy"
    },
    {
      "properties": {
        "policy_id": {
          "const": "h2epr_0288_strict_source_policy"
        },
        "policy_version": {
          "const": "h2epr_0288_strict_source_policy.v1"
        },
        "event_spec_observed_json_pointers": {
          "const": [
            "/category",
            "/domain",
            "/event_descriptor",
            "/keywords",
            "/language_mode",
            "/public_event_id",
            "/region_hint",
            "/schema_version",
            "/time_hint",
            "/title"
          ]
        },
        "event_spec_allowed_json_pointers": {
          "const": [
            "/domain",
            "/language_mode",
            "/public_event_id",
            "/schema_version",
            "/title"
          ]
        },
        "non_allowlist_field_adjudications": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "json_pointer": {
                    "const": "/category"
                  }
                },
                "required": [
                  "json_pointer"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "json_pointer": {
                    "const": "/event_descriptor"
                  }
                },
                "required": [
                  "json_pointer"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "json_pointer": {
                    "const": "/keywords"
                  }
                },
                "required": [
                  "json_pointer"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "json_pointer": {
                    "const": "/region_hint"
                  }
                },
                "required": [
                  "json_pointer"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "json_pointer": {
                    "const": "/time_hint"
                  }
                },
                "required": [
                  "json_pointer"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "source_kind_allowlist": {
          "const": [
            "draft_epg_prefix_projection",
            "event_spec",
            "generic_contract",
            "non_target_contemporaneous_source",
            "synthetic"
          ]
        },
        "gold_fallback_policy": {
          "const": "prohibited"
        },
        "raw_full_draft_handle_policy": {
          "const": "prohibited"
        }
      }
    }
  ]
}
