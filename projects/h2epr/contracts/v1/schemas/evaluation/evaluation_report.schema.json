{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AgenticFinLab/multiagent-simulation/main/projects/h2epr/contracts/v1/schemas/evaluation/evaluation_report.schema.json",
  "title": "H2EPR Simulation Evaluation Report",
  "$ref": "#/$defs/EvaluationReport",
  "$defs": {
    "StableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "EvaluationLineageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "construction_state",
        "artifact_scope",
        "source_scope",
        "builder_access",
        "contamination_status",
        "protocol_eligibility",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/StableId"
        },
        "artifact_kind": {
          "enum": [
            "simulation_trace",
            "generated_epg"
          ]
        },
        "construction_state": {
          "enum": [
            "full_draft_target_demo",
            "prefix_contaminated_demo",
            "prefix_clean_strict"
          ]
        },
        "artifact_scope": {
          "const": "target_specific"
        },
        "source_scope": {
          "enum": [
            "full_draft_target_specific",
            "prefix_target_specific"
          ]
        },
        "builder_access": {
          "enum": [
            "full_target_draft",
            "prefix_inputs_after_full_draft_exposure",
            "prefix_allowlist_only"
          ]
        },
        "contamination_status": {
          "enum": [
            "full_draft_exposed",
            "clean_prefix_only"
          ]
        },
        "protocol_eligibility": {
          "enum": [
            "architecture_demo_only",
            "strict_eligible"
          ]
        },
        "artifact_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "oneOf": [
        {
          "properties": {
            "construction_state": {
              "const": "full_draft_target_demo"
            },
            "source_scope": {
              "const": "full_draft_target_specific"
            },
            "builder_access": {
              "const": "full_target_draft"
            },
            "contamination_status": {
              "const": "full_draft_exposed"
            },
            "protocol_eligibility": {
              "const": "architecture_demo_only"
            }
          }
        },
        {
          "properties": {
            "construction_state": {
              "const": "prefix_contaminated_demo"
            },
            "source_scope": {
              "const": "prefix_target_specific"
            },
            "builder_access": {
              "const": "prefix_inputs_after_full_draft_exposure"
            },
            "contamination_status": {
              "const": "full_draft_exposed"
            },
            "protocol_eligibility": {
              "const": "architecture_demo_only"
            }
          }
        },
        {
          "properties": {
            "construction_state": {
              "const": "prefix_clean_strict"
            },
            "source_scope": {
              "const": "prefix_target_specific"
            },
            "builder_access": {
              "const": "prefix_allowlist_only"
            },
            "contamination_status": {
              "const": "clean_prefix_only"
            },
            "protocol_eligibility": {
              "const": "strict_eligible"
            }
          }
        }
      ]
    },
    "EvaluationArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_kind",
        "schema_version",
        "producer_version",
        "construction_state",
        "artifact_scope",
        "source_scope",
        "builder_access",
        "contamination_status",
        "protocol_eligibility",
        "parent_artifacts",
        "review_state"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/StableId"
        },
        "artifact_kind": {
          "const": "evaluation_report"
        },
        "schema_version": {
          "$ref": "#/$defs/StableId"
        },
        "producer_version": {
          "$ref": "#/$defs/StableId"
        },
        "construction_state": {
          "enum": [
            "full_draft_target_demo",
            "prefix_contaminated_demo",
            "prefix_clean_strict"
          ]
        },
        "artifact_scope": {
          "const": "target_specific"
        },
        "source_scope": {
          "enum": [
            "full_draft_target_specific",
            "prefix_target_specific"
          ]
        },
        "builder_access": {
          "enum": [
            "full_target_draft",
            "prefix_inputs_after_full_draft_exposure",
            "prefix_allowlist_only"
          ]
        },
        "contamination_status": {
          "enum": [
            "full_draft_exposed",
            "clean_prefix_only"
          ]
        },
        "protocol_eligibility": {
          "enum": [
            "architecture_demo_only",
            "strict_eligible"
          ]
        },
        "parent_artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/EvaluationLineageRef"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "artifact_kind": {
                    "const": "simulation_trace"
                  }
                },
                "required": [
                  "artifact_kind"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "artifact_kind": {
                    "const": "generated_epg"
                  }
                },
                "required": [
                  "artifact_kind"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "review_state": {
          "enum": [
            "draft",
            "reviewed",
            "approved",
            "rejected"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "construction_state": {
              "const": "full_draft_target_demo"
            },
            "source_scope": {
              "const": "full_draft_target_specific"
            },
            "builder_access": {
              "const": "full_target_draft"
            },
            "contamination_status": {
              "const": "full_draft_exposed"
            },
            "protocol_eligibility": {
              "const": "architecture_demo_only"
            }
          }
        },
        {
          "properties": {
            "construction_state": {
              "const": "prefix_contaminated_demo"
            },
            "source_scope": {
              "const": "prefix_target_specific"
            },
            "builder_access": {
              "const": "prefix_inputs_after_full_draft_exposure"
            },
            "contamination_status": {
              "const": "full_draft_exposed"
            },
            "protocol_eligibility": {
              "const": "architecture_demo_only"
            }
          }
        },
        {
          "properties": {
            "construction_state": {
              "const": "prefix_clean_strict"
            },
            "source_scope": {
              "const": "prefix_target_specific"
            },
            "builder_access": {
              "const": "prefix_allowlist_only"
            },
            "contamination_status": {
              "const": "clean_prefix_only"
            },
            "protocol_eligibility": {
              "const": "strict_eligible"
            }
          }
        }
      ]
    },
    "EvaluationProtocolContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_label",
        "construction_state",
        "artifact_scope",
        "source_scope",
        "builder_access",
        "contamination_status",
        "protocol_eligibility",
        "root_construction_artifact_id"
      ],
      "properties": {
        "protocol_label": {
          "enum": [
            "architecture_development_demo",
            "architecture_debug_gold_fallback",
            "strict_continuation"
          ]
        },
        "construction_state": {
          "enum": [
            "full_draft_target_demo",
            "prefix_contaminated_demo",
            "prefix_clean_strict"
          ]
        },
        "artifact_scope": {
          "const": "target_specific"
        },
        "source_scope": {
          "enum": [
            "full_draft_target_specific",
            "prefix_target_specific"
          ]
        },
        "builder_access": {
          "enum": [
            "full_target_draft",
            "prefix_inputs_after_full_draft_exposure",
            "prefix_allowlist_only"
          ]
        },
        "contamination_status": {
          "enum": [
            "full_draft_exposed",
            "clean_prefix_only"
          ]
        },
        "protocol_eligibility": {
          "enum": [
            "architecture_demo_only",
            "strict_eligible"
          ]
        },
        "root_construction_artifact_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "oneOf": [
        {
          "properties": {
            "protocol_label": {
              "enum": [
                "architecture_development_demo",
                "architecture_debug_gold_fallback"
              ]
            },
            "construction_state": {
              "const": "full_draft_target_demo"
            },
            "source_scope": {
              "const": "full_draft_target_specific"
            },
            "builder_access": {
              "const": "full_target_draft"
            },
            "contamination_status": {
              "const": "full_draft_exposed"
            },
            "protocol_eligibility": {
              "const": "architecture_demo_only"
            }
          }
        },
        {
          "properties": {
            "protocol_label": {
              "const": "architecture_development_demo"
            },
            "construction_state": {
              "const": "prefix_contaminated_demo"
            },
            "source_scope": {
              "const": "prefix_target_specific"
            },
            "builder_access": {
              "const": "prefix_inputs_after_full_draft_exposure"
            },
            "contamination_status": {
              "const": "full_draft_exposed"
            },
            "protocol_eligibility": {
              "const": "architecture_demo_only"
            }
          }
        },
        {
          "properties": {
            "protocol_label": {
              "const": "strict_continuation"
            },
            "construction_state": {
              "const": "prefix_clean_strict"
            },
            "source_scope": {
              "const": "prefix_target_specific"
            },
            "builder_access": {
              "const": "prefix_allowlist_only"
            },
            "contamination_status": {
              "const": "clean_prefix_only"
            },
            "protocol_eligibility": {
              "const": "strict_eligible"
            }
          }
        }
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_generated_count",
        "eligible_reference_count",
        "compared_generated_count",
        "compared_reference_count",
        "generated_coverage_rate",
        "reference_coverage_rate"
      ],
      "properties": {
        "eligible_generated_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "compared_generated_count": {
          "type": "integer",
          "minimum": 0
        },
        "compared_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "generated_coverage_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reference_coverage_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "DimensionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "status",
        "value",
        "coverage",
        "missingness_reason_codes",
        "invalidity_reason_codes",
        "metric_version"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "structural_process_fidelity",
            "temporal_evolution_fidelity",
            "causal_mechanistic_fidelity",
            "participant_behavioral_fidelity",
            "outcome_fidelity",
            "traceability_to_simulation_logs",
            "run_to_run_stability_and_diversity"
          ]
        },
        "status": {
          "enum": [
            "evaluated",
            "partially_evaluated",
            "not_evaluable",
            "invalid"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "missingness_reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          }
        },
        "invalidity_reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          }
        },
        "metric_version": {
          "$ref": "#/$defs/StableId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_evaluable",
                  "invalid"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "AlignmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_id",
        "generated_ids",
        "reference_ids",
        "component_type",
        "status",
        "similarity",
        "config_version"
      ],
      "properties": {
        "alignment_id": {
          "$ref": "#/$defs/StableId"
        },
        "generated_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "uniqueItems": true
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "uniqueItems": true
        },
        "component_type": {
          "$ref": "#/$defs/StableId"
        },
        "status": {
          "enum": [
            "primary_match",
            "auxiliary_split_merge",
            "unmatched_generated",
            "unmatched_reference",
            "contradicted",
            "not_comparable"
          ]
        },
        "similarity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "config_version": {
          "$ref": "#/$defs/StableId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unmatched_generated"
              }
            }
          },
          "then": {
            "properties": {
              "generated_ids": {
                "minItems": 1
              },
              "reference_ids": {
                "maxItems": 0
              },
              "similarity": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unmatched_reference"
              }
            }
          },
          "then": {
            "properties": {
              "generated_ids": {
                "maxItems": 0
              },
              "reference_ids": {
                "minItems": 1
              },
              "similarity": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "primary_match",
                  "auxiliary_split_merge",
                  "contradicted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "generated_ids": {
                "minItems": 1
              },
              "reference_ids": {
                "minItems": 1
              },
              "similarity": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "EvaluationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_identity",
        "protocol_context",
        "source_kind",
        "claim_label",
        "report_id",
        "schema_version",
        "run_id",
        "source_manifest_sha256",
        "source_trace_id",
        "source_generated_epg_id",
        "generated_epg_sha256",
        "trace_sha256",
        "reference_asset_id",
        "reference_sha256",
        "seal_handshake",
        "dimensions",
        "alignments",
        "output_validity",
        "composite_score",
        "canonicalization_version",
        "report_hash_preimage",
        "report_sha256"
      ],
      "properties": {
        "artifact_identity": {
          "$ref": "#/$defs/EvaluationArtifactIdentity"
        },
        "protocol_context": {
          "$ref": "#/$defs/EvaluationProtocolContext"
        },
        "source_kind": {
          "enum": [
            "authentic_finmycelium_draft",
            "gold_fallback",
            "synthetic"
          ]
        },
        "claim_label": {
          "enum": [
            "engineering_diagnostic_only",
            "gold_fallback_debug_only",
            "strict_continuation_result"
          ]
        },
        "report_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "source_trace_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_generated_epg_id": {
          "$ref": "#/$defs/StableId"
        },
        "generated_epg_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "trace_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "reference_asset_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "seal_handshake": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_seal_valid",
            "graph_seal_valid",
            "compiler_blind_attestation",
            "status"
          ],
          "properties": {
            "run_seal_valid": {
              "const": true
            },
            "graph_seal_valid": {
              "const": true
            },
            "compiler_blind_attestation": {
              "const": true
            },
            "status": {
              "const": "pass"
            }
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/DimensionResult"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "structural_process_fidelity"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "temporal_evolution_fidelity"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "causal_mechanistic_fidelity"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "participant_behavioral_fidelity"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "outcome_fidelity"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "traceability_to_simulation_logs"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "dimension": {
                    "const": "run_to_run_stability_and_diversity"
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "alignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlignmentItem"
          }
        },
        "output_validity": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "composite_score": {
          "type": "null"
        },
        "canonicalization_version": {
          "const": "h2epr_cjson.v1"
        },
        "report_hash_preimage": {
          "const": "omit_report_sha256"
        },
        "report_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "gold_fallback"
              }
            }
          },
          "then": {
            "properties": {
              "protocol_context": {
                "properties": {
                  "protocol_label": {
                    "const": "architecture_debug_gold_fallback"
                  },
                  "construction_state": {
                    "const": "full_draft_target_demo"
                  }
                }
              },
              "claim_label": {
                "const": "gold_fallback_debug_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol_context": {
                "properties": {
                  "protocol_label": {
                    "const": "strict_continuation"
                  }
                },
                "required": [
                  "protocol_label"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_kind": {
                "enum": [
                  "authentic_finmycelium_draft",
                  "synthetic"
                ]
              },
              "claim_label": {
                "const": "strict_continuation_result"
              },
              "artifact_identity": {
                "properties": {
                  "construction_state": {
                    "const": "prefix_clean_strict"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol_context": {
                "properties": {
                  "protocol_label": {
                    "const": "architecture_development_demo"
                  }
                },
                "required": [
                  "protocol_label"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "claim_label": {
                "const": "engineering_diagnostic_only"
              }
            }
          }
        }
      ]
    }
  }
}
