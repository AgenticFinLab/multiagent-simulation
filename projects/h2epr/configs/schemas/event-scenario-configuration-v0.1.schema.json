{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticfinlab.local/h2epr/configs/schemas/event-scenario-configuration-v0.1.schema.json",
  "title": "H2EPR Event Scenario Configuration v0.1 admission schema",
  "description": "Project-local structural admission schema. It is not a Contracts V1 carrier schema and does not make a configuration executable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "configuration_id",
    "version",
    "status",
    "event_id",
    "purpose",
    "historical_calibration",
    "historical_validation",
    "known_outcome_fitting",
    "semantic_inputs",
    "execution_boundary",
    "clock",
    "structural_variants",
    "named_actors",
    "population_actors",
    "population_units",
    "initial_records",
    "exogenous_inputs",
    "policy_selections",
    "sensitivity_overlays",
    "completion_policy",
    "validation_expectations"
  ],
  "properties": {
    "schema": {
      "const": "h2epr.event-scenario-configuration.v0_1"
    },
    "configuration_id": {
      "$ref": "#/$defs/stableId"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "status": {
      "$ref": "#/$defs/semanticToken"
    },
    "event_id": {
      "$ref": "#/$defs/stableId"
    },
    "purpose": {
      "$ref": "#/$defs/semanticToken"
    },
    "historical_calibration": {
      "type": "boolean"
    },
    "historical_validation": {
      "type": "boolean"
    },
    "known_outcome_fitting": {
      "type": "boolean"
    },
    "semantic_inputs": {
      "$ref": "#/$defs/semanticInputs"
    },
    "execution_boundary": {
      "$ref": "#/$defs/executionBoundary"
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "structural_variants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^SV-[A-Z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "named_actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "population_actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "population_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/populationUnit"
      }
    },
    "initial_records": {
      "$ref": "#/$defs/initialRecords"
    },
    "exogenous_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exogenousInput"
      }
    },
    "policy_selections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^POL-[A-Z0-9-]+-[0-9]{2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/policySelection"
      }
    },
    "sensitivity_overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sensitivityOverlay"
      }
    },
    "completion_policy": {
      "$ref": "#/$defs/completionPolicy"
    },
    "validation_expectations": {
      "$ref": "#/$defs/validationExpectations"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "semanticToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "stableIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "semanticInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_definition_id",
        "scenario_definition_sha256",
        "scenario_release_manifest_sha256",
        "roster_release_manifest_sha256",
        "consolidated_mapping_manifest_sha256",
        "mapping_profile_sha256",
        "evidence_ledger_sha256",
        "source_register_sha256"
      ],
      "properties": {
        "scenario_definition_id": {
          "$ref": "#/$defs/stableId"
        },
        "scenario_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scenario_release_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "roster_release_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "consolidated_mapping_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mapping_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_register_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_eligible",
        "reason",
        "required_before_execution"
      ],
      "properties": {
        "execution_eligible": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/nonemptyString"
        },
        "required_before_execution": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "start",
        "primary_window_start",
        "primary_window_end",
        "analytic_horizon",
        "horizon_basis",
        "mode",
        "same_time_policy",
        "invented_intraday_precision_forbidden"
      ],
      "properties": {
        "timezone": {
          "$ref": "#/$defs/nonemptyString"
        },
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "primary_window_start": {
          "$ref": "#/$defs/timestamp"
        },
        "primary_window_end": {
          "$ref": "#/$defs/timestamp"
        },
        "analytic_horizon": {
          "$ref": "#/$defs/timestamp"
        },
        "horizon_basis": {
          "$ref": "#/$defs/nonemptyString"
        },
        "mode": {
          "$ref": "#/$defs/semanticToken"
        },
        "same_time_policy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticToken"
          }
        },
        "invented_intraday_precision_forbidden": {
          "type": "boolean"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "entity_id",
        "participant_artifact_id",
        "capability_ids",
        "authority_graph_id",
        "resource_owner_id"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/stableId"
        },
        "entity_id": {
          "$ref": "#/$defs/stableId"
        },
        "participant_artifact_id": {
          "$ref": "#/$defs/stableId"
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticToken"
          }
        },
        "authority_graph_id": {
          "$ref": "#/$defs/stableId"
        },
        "resource_owner_id": {
          "$ref": "#/$defs/stableId"
        },
        "transferable_resource_capability": {
          "type": "boolean"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "status"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/semanticToken"
        },
        "status": {
          "$ref": "#/$defs/semanticToken"
        }
      }
    },
    "privateNeedActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "dated_exogenous_input",
            "none_in_baseline"
          ]
        },
        "input_id": {
          "$ref": "#/$defs/stableId"
        },
        "activated_value": {
          "$ref": "#/$defs/semanticToken"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "dated_exogenous_input"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "input_id",
              "activated_value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none_in_baseline"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "input_id"
                  ]
                },
                {
                  "required": [
                    "activated_value"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "populationUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "actor_id",
        "capability_id",
        "weight"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/stableId"
        },
        "actor_id": {
          "$ref": "#/$defs/stableId"
        },
        "capability_id": {
          "$ref": "#/$defs/semanticToken"
        },
        "host_entity_id": {
          "$ref": "#/$defs/stableId"
        },
        "institution_entity_id": {
          "$ref": "#/$defs/stableId"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weight_status": {
          "$ref": "#/$defs/semanticToken"
        },
        "claim": {
          "$ref": "#/$defs/claim"
        },
        "opening_private_need": {
          "$ref": "#/$defs/semanticToken"
        },
        "private_need_activation": {
          "$ref": "#/$defs/privateNeedActivation"
        },
        "response_profile": {
          "$ref": "#/$defs/semanticToken"
        },
        "mixed_signal_rule": {
          "$ref": "#/$defs/semanticToken"
        },
        "participation_posture": {
          "$ref": "#/$defs/semanticToken"
        },
        "certificate_use_posture": {
          "$ref": "#/$defs/semanticToken"
        },
        "resource_posture": {
          "$ref": "#/$defs/semanticToken"
        },
        "existing_exposure_posture": {
          "$ref": "#/$defs/semanticToken"
        },
        "new_lending_posture": {
          "$ref": "#/$defs/semanticToken"
        },
        "funding_response_posture": {
          "$ref": "#/$defs/semanticToken"
        },
        "amount_method": {
          "$ref": "#/$defs/semanticToken"
        }
      },
      "oneOf": [
        {
          "required": [
            "host_entity_id",
            "weight_status",
            "claim",
            "opening_private_need",
            "private_need_activation",
            "response_profile",
            "mixed_signal_rule"
          ],
          "not": {
            "required": [
              "institution_entity_id"
            ]
          }
        },
        {
          "required": [
            "institution_entity_id",
            "amount_method"
          ],
          "not": {
            "required": [
              "host_entity_id"
            ]
          },
          "anyOf": [
            {
              "required": [
                "participation_posture"
              ]
            },
            {
              "required": [
                "new_lending_posture"
              ]
            },
            {
              "required": [
                "funding_response_posture"
              ]
            }
          ]
        }
      ]
    },
    "authorityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "actor_id",
        "scope",
        "state",
        "source_class"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/stableId"
        },
        "actor_id": {
          "$ref": "#/$defs/stableId"
        },
        "scope": {
          "$ref": "#/$defs/semanticToken"
        },
        "state": {
          "$ref": "#/$defs/semanticToken"
        },
        "source_class": {
          "$ref": "#/$defs/semanticToken"
        }
      }
    },
    "relationshipRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "parties",
        "kind",
        "state",
        "source_class"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/stableId"
        },
        "parties": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "kind": {
          "$ref": "#/$defs/semanticToken"
        },
        "state": {
          "$ref": "#/$defs/semanticToken"
        },
        "source_class": {
          "$ref": "#/$defs/semanticToken"
        },
        "focal_contract_classification": {
          "$ref": "#/$defs/semanticToken"
        }
      }
    },
    "resourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "owner_id",
        "concept",
        "value",
        "unit",
        "identification",
        "visibility"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/stableId"
        },
        "owner_id": {
          "$ref": "#/$defs/stableId"
        },
        "concept": {
          "$ref": "#/$defs/semanticToken"
        },
        "value": {
          "$ref": "#/$defs/semanticToken"
        },
        "unit": {
          "$ref": "#/$defs/semanticToken"
        },
        "identification": {
          "$ref": "#/$defs/semanticToken"
        },
        "visibility": {
          "$ref": "#/$defs/semanticToken"
        }
      }
    },
    "businessObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "family",
        "owner_actor_id",
        "counterparty_actor_id",
        "state",
        "version",
        "amount",
        "unit",
        "source_class"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/stableId"
        },
        "family": {
          "$ref": "#/$defs/semanticToken"
        },
        "owner_actor_id": {
          "$ref": "#/$defs/stableId"
        },
        "counterparty_actor_id": {
          "$ref": "#/$defs/stableId"
        },
        "state": {
          "$ref": "#/$defs/semanticToken"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "amount": {
          "$ref": "#/$defs/semanticToken"
        },
        "unit": {
          "$ref": "#/$defs/semanticToken"
        },
        "source_class": {
          "$ref": "#/$defs/semanticToken"
        }
      }
    },
    "initialRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "relationships",
        "resource_and_condition_projections",
        "business_objects"
      ],
      "properties": {
        "authority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authorityRecord"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationshipRecord"
          }
        },
        "resource_and_condition_projections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRecord"
          }
        },
        "business_objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/businessObject"
          }
        }
      }
    },
    "exogenousInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "effect",
        "source_class",
        "outcome_forcing"
      ],
      "properties": {
        "input_id": {
          "$ref": "#/$defs/stableId"
        },
        "event_window": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "selection": {
          "$ref": "#/$defs/semanticToken"
        },
        "target_unit_ids": {
          "$ref": "#/$defs/stableIdArray"
        },
        "effect": {
          "$ref": "#/$defs/nonemptyString"
        },
        "claim_refs": {
          "$ref": "#/$defs/stableIdArray"
        },
        "source_class": {
          "$ref": "#/$defs/semanticToken"
        },
        "outcome_forcing": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "event_window"
          ],
          "not": {
            "required": [
              "selection"
            ]
          }
        },
        {
          "required": [
            "selection"
          ],
          "not": {
            "required": [
              "event_window"
            ]
          }
        }
      ]
    },
    "policySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "selection",
        "implementation_status"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "selection": {
          "$ref": "#/$defs/semanticToken"
        },
        "implementation_status": {
          "enum": [
            "unbound",
            "bound"
          ]
        }
      }
    },
    "sensitivityOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_kind",
        "target_id",
        "field",
        "value"
      ],
      "properties": {
        "target_kind": {
          "enum": [
            "structural_variant",
            "population_unit",
            "exogenous_input",
            "clock"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/stableId"
        },
        "field": {
          "$ref": "#/$defs/semanticToken"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "sensitivityOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay_id",
        "operations"
      ],
      "properties": {
        "overlay_id": {
          "type": "string",
          "pattern": "^SENS-[A-Z0-9-]+$"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sensitivityOperation"
          }
        }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal",
        "bounded_incomplete",
        "failed_closed"
      ],
      "properties": {
        "normal": {
          "$ref": "#/$defs/nonemptyString"
        },
        "bounded_incomplete": {
          "$ref": "#/$defs/nonemptyString"
        },
        "failed_closed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticToken"
          }
        }
      }
    },
    "validationExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_products",
        "observation_placements",
        "intent_placements",
        "named_actors",
        "population_actors",
        "population_units",
        "one_actor_per_entity",
        "one_resource_owner_per_entity",
        "host_scope_required_for_depositor_units",
        "intent_result_separation_required",
        "deterministic_replay_required"
      ],
      "properties": {
        "semantic_products": {
          "type": "integer",
          "minimum": 1
        },
        "observation_placements": {
          "type": "integer",
          "minimum": 1
        },
        "intent_placements": {
          "type": "integer",
          "minimum": 1
        },
        "named_actors": {
          "type": "integer",
          "minimum": 1
        },
        "population_actors": {
          "type": "integer",
          "minimum": 0
        },
        "population_units": {
          "type": "integer",
          "minimum": 0
        },
        "one_actor_per_entity": {
          "type": "boolean"
        },
        "one_resource_owner_per_entity": {
          "type": "boolean"
        },
        "host_scope_required_for_depositor_units": {
          "type": "boolean"
        },
        "intent_result_separation_required": {
          "type": "boolean"
        },
        "deterministic_replay_required": {
          "type": "boolean"
        }
      }
    }
  }
}
