# MASIM Nginx Configuration Template — Single-instance Streamlit
# Generated by: sudo bash deploy/set-max-users.sh <N>
# Placeholder {{MAX_USERS}} is replaced with the chosen concurrent-user cap.
#
# Serves 1 Streamlit instance (port 8502) behind port 80.  Streamlit
# session_state is per-WebSocket, so a single process safely handles
# multiple users; extra instances would only add baseline memory overhead.

# --- Connection limiting ---
# Total concurrent connections across all clients.  Once the limit is
# reached, new visitors get a 503 "at capacity" page.
limit_conn_zone $server_name zone=masim_total:1m;

upstream masim_backend {
    server 127.0.0.1:8502;
}

server {
    listen 80;
    server_name _;

    # Timeouts — balance between keeping active simulation sessions alive
    # and releasing idle/orphaned connections.  Streamlit sends periodic
    # heartbeat pings (~30s), so a truly active session will never hit this.
    # Idle/closed-browser connections get reclaimed after 30 min of silence.
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_connect_timeout 10s;

    # Buffers — reduce overhead for small WebSocket frames
    proxy_buffering off;
    proxy_request_buffering off;

    # --- Concurrent user cap ---
    # At most {{MAX_USERS}} simultaneous connections to the entire server.
    # Each Streamlit session holds 1 WebSocket, so this ≈ {{MAX_USERS}} active users.
    limit_conn masim_total {{MAX_USERS}};
    limit_conn_status 503;

    # Custom "at capacity" page
    error_page 503 /503.html;
    location = /503.html {
        internal;
        default_type text/html;
        return 503 '<!DOCTYPE html><html lang="zh"><head><meta charset="utf-8"><title>服务器已满</title><style>body{font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;background:#f8fafc}div{text-align:center;max-width:420px;padding:2rem}.icon{font-size:3rem;margin-bottom:1rem}h1{margin:0 0 .5rem;font-size:1.5rem}p{color:#64748b;line-height:1.6}</style></head><body><div><div class="icon">🚦</div><h1>当前访问人数已满</h1><p>服务器最多支持 {{MAX_USERS}} 位用户同时使用。<br>请稍后刷新页面重试。</p></div></body></html>';
    }

    # Main application
    location / {
        proxy_pass http://masim_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Streamlit static assets (cache aggressively)
    location /static {
        proxy_pass http://masim_backend;
        proxy_cache_valid 200 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    # Health check endpoint (optional, useful for monitoring)
    location /healthz {
        access_log off;
        proxy_pass http://masim_backend/_stcore/health;
    }
}
